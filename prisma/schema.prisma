generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  extensions = [vector]
}

model Summary {
  id          String   @id @default(cuid())
  url         String?
  title       String
  summary     String
  keyPoints   String[]
  tags        String[]
  readingTime Int
  createdAt   DateTime @default(now())

  embedding   Unsupported("vector(1536)")?
}